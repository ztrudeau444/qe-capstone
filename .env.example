# Copy to .env and fill in. .env is gitignored and must stay that way.
# Anything secret belongs in GitHub Actions secrets, not here.

# The deployed instance your Week 3 and Week 4 stages run against
BASE_URL=http://localhost:8080

# Database used by Week 2 integration tests
DB_URL=postgresql://qe:qe@localhost:5432/qe
DB_USER=qe
DB_PASSWORD=qe

# Test account used by E2E and smoke tests. Never a real user.
TEST_USER=qa.user@example.test
TEST_PASSWORD=change-me
